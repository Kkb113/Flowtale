FROM node:22.23.2@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d AS dependencies
WORKDIR /workspace
COPY package.json yarn.lock ./
COPY packages/common/package.json ./packages/common/package.json
COPY packages/client/package.json ./packages/client/package.json
COPY packages/ext-tour/package.json ./packages/ext-tour/package.json
RUN node --version && yarn --version && yarn install --frozen-lockfile

FROM dependencies AS source
COPY . .
RUN yarn workspace @fable/common build

FROM source AS extension
RUN yarn workspace @fable/ext-tour build-local

FROM extension AS checks
ENV CI=true
RUN yarn workspace @fable/common lint && yarn workspace @fable/client lint && yarn workspace @fable/ext-tour lint
RUN yarn workspace @fable/common test --runInBand && yarn workspace @fable/client test --watchAll=false --runInBand && yarn workspace @fable/ext-tour test --runInBand
RUN yarn workspace @fable/client build-prod

FROM source AS development
ENV HOST=0.0.0.0 PORT=3000 BROWSER=none NODE_OPTIONS=--max-old-space-size=3072 YARN_CACHE_FOLDER=/tmp/yarn-cache
RUN mkdir -p node_modules/.cache packages/client/node_modules/.cache && chown -R node:node node_modules/.cache packages/client/node_modules/.cache
USER node
EXPOSE 3000
ENTRYPOINT ["yarn", "workspace", "@fable/client", "start-local"]
